<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-targeted so the tray can be referenced and its Windows-only logic tested. The app
         is Windows-only anyway and CI runs on windows-latest, so nothing is lost by saying so. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FidoRelay.Api\FidoRelay.Api.csproj" />
    <ProjectReference Include="..\FidoRelay.Core\FidoRelay.Core.csproj" />
    <ProjectReference Include="..\FidoRelay.Tray\FidoRelay.Tray.csproj" />
  </ItemGroup>

</Project>