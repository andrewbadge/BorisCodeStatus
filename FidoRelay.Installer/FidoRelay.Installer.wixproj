<Project Sdk="WixToolset.Sdk/4.0.5">

  <PropertyGroup>
    <OutputName>FidoRelay</OutputName>
    <OutputType>Package</OutputType>

    <!-- Where the two self-contained publishes are gathered before harvesting. -->
    <StageDir>$(MSBuildProjectDirectory)\obj\stage\</StageDir>

    <!-- Version comes from Directory.Build.props by default and is overridden on the command line
         by CI (-p:Version=1.2.3, derived from the release tag). It must increase between releases
         or MajorUpgrade will refuse to replace the installed copy. -->
    <DefineConstants>StageDir=$(StageDir);Version=$(Version)</DefineConstants>

    <!-- ICE38/ICE43/ICE57 fire on every per-user install that writes files under the user profile
         without an HKCU keypath per component. The design is deliberately per-user (the target
         user is not a local administrator), so these are expected rather than defects. -->
    <SuppressIces>ICE38;ICE43;ICE57;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <!-- Heat supplies the HarvestDirectory item below. WiX v4 has no <Files> globbing element
         (that arrived in v5), so the payload is harvested instead of hand-authored. -->
    <PackageReference Include="WixToolset.Heat" Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>

  <!--
    Harvests the staging folder into a generated ApplicationFiles component group. Generated
    rather than listed by hand because a self-contained .NET publish is ~150 files whose exact
    set changes with every SDK update; a hand-written manifest would rot immediately.
  -->
  <ItemGroup>
    <HarvestDirectory Include="$(StageDir)">
      <ComponentGroupName>ApplicationFiles</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressCom>true</SuppressCom>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>

    <!-- Heat writes the harvested paths relative to SourceDir; this is where SourceDir points. -->
    <BindInputPaths Include="$(StageDir)" />
  </ItemGroup>

  <!--
    The MSI must contain the self-contained publish output, not the plain build output, so the
    target machine needs no .NET runtime installed. ProjectReference would give us the build
    output, so publish explicitly into a staging folder and harvest that instead.
  -->
  <Target Name="PublishPayload" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(StageDir)" />

    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\FidoRelay.Tray\FidoRelay.Tray.csproj&quot; -c $(Configuration) -o &quot;$(StageDir.TrimEnd('\'))&quot; -p:Version=$(Version) --nologo" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\FidoRelay.Hooks\FidoRelay.Hooks.csproj&quot; -c $(Configuration) -o &quot;$(StageDir.TrimEnd('\'))&quot; -p:Version=$(Version) --nologo" />

    <!-- The hook exe is published single-file; its loose intermediates must not also ship. -->
    <ItemGroup>
      <StagedPdb Include="$(StageDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(StagedPdb)" />
  </Target>

</Project>
