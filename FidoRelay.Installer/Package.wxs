<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Per-user install by design.

    Scope="perUser" means: no elevation, no UAC prompt, no Program Files, no Windows service.
    Everything lands under the invoking user's profile and HKCU, so a user who is not a local
    administrator can install, upgrade and uninstall this themselves.
  -->
  <Package
      Name="FidoRelay"
      Manufacturer="FidoRelay"
      Version="$(var.Version)"
      UpgradeCode="5f2a1c7e-9d84-4b31-8c06-1f7a3e5b90d2"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of FidoRelay is already installed."
        AllowSameVersionUpgrades="yes" />
    <!-- ICE61 warns that Maximum == current version; that is the expected consequence of
         AllowSameVersionUpgrades, which lets a rebuilt 1.0.0 reinstall over itself during
         development instead of failing with "another version is already installed". -->

    <MediaTemplate EmbedCab="yes" />

    <!-- The dog in Installed Apps. The Start Menu shortcut needs no Icon attribute: it inherits
         the icon compiled into the target executable. -->
    <Icon Id="FidoIcon" SourceFile="..\FidoRelay.Tray\fido.ico" />
    <Property Id="ARPPRODUCTICON" Value="FidoIcon" />

    <!-- %LOCALAPPDATA%\Programs\FidoRelay -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FidoRelay" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="FidoRelay" />
    </StandardDirectory>

    <Feature Id="Main" Title="FidoRelay" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="Registration" />
    </Feature>

    <!--
      ApplicationFiles is generated by heat from the staging folder (see the .wixproj): the
      self-contained publish output of both executables. The tray exe loads the API and Core
      assemblies from this same folder, and the hook exe sits beside it so the tray can register
      it in settings.json by absolute path.

      Registration below is the hand-authored part: startup and shortcut entries, all in HKCU.
    -->
    <ComponentGroup Id="Registration" Directory="INSTALLFOLDER">

      <!-- Start at login. A Run key rather than a scheduled task or service: it needs no elevation
           and it starts in the user's interactive session, which a tray icon requires. Removed
           automatically on uninstall because the whole component is removed. -->
      <Component Id="RunAtLogin" Guid="c4b18f6a-2e57-4a90-93d1-6f0b8c2d4e11">
        <RegistryValue
            Root="HKCU"
            Key="Software\Microsoft\Windows\CurrentVersion\Run"
            Name="FidoRelay"
            Type="string"
            Value="&quot;[INSTALLFOLDER]FidoRelay.Tray.exe&quot;" />
      </Component>

      <Component Id="StartMenuShortcut" Guid="9a7c3d21-5b46-4e8f-a0c2-7d3e1f5a8b64">
        <Shortcut
            Id="TrayShortcut"
            Directory="ShortcutFolder"
            Name="FidoRelay"
            Target="[INSTALLFOLDER]FidoRelay.Tray.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\FidoRelay"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      Launch the tray app at the end of a successful install. This is what registers the hooks in
      ~/.claude/settings.json: the merge lives in the app's startup path, not in an MSI custom
      action. See the README for why.
    -->
    <!-- Addressed by path rather than by [#FileId]: the file ids in ApplicationFiles are generated
         by heat and are not stable to depend on from hand-written authoring. Set via SetProperty
         rather than a Property element so [INSTALLFOLDER] is resolved at run time, not at build. -->
    <SetProperty
        Id="WixShellExecTarget"
        Value="[INSTALLFOLDER]FidoRelay.Tray.exe"
        Before="LaunchTray"
        Sequence="execute" />

    <CustomAction
        Id="LaunchTray"
        BinaryRef="Wix4UtilCA_X86"
        DllEntry="WixShellExec"
        Impersonate="yes"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="LaunchTray" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>

    <!--
      Stop the running tray before upgrading or removing, or the old process keeps running against
      replaced binaries and the upgrade silently has no effect until the next login.

      TerminateProcess is required here, not optional. CloseMessage alone sends WM_CLOSE to a
      matching *window*, and this app deliberately has no window — only a tray icon — so there is
      nothing for that message to reach. Without TerminateProcess the old process survives every
      upgrade. Terminating is safe: state is file-backed and every write is atomic, so there is no
      graceful-shutdown work to lose.
    -->
    <util:CloseApplication
        xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
        Id="CloseTray"
        Target="FidoRelay.Tray.exe"
        CloseMessage="yes"
        TerminateProcess="1"
        RebootPrompt="no"
        Timeout="10" />

    <!--
      The same, for the executable's pre-rename name. Upgrading from a ClaudeVitals install would
      otherwise leave that tray running: it keeps port 5080, so the freshly installed FidoRelay
      tray cannot bind and greets the user with the "port already in use" dialog instead of an icon.
      Removable once nobody is running a pre-rename build.
    -->
    <util:CloseApplication
        xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
        Id="CloseLegacyTray"
        Target="ClaudeVitals.Tray.exe"
        CloseMessage="yes"
        TerminateProcess="1"
        RebootPrompt="no"
        Timeout="10" />

  </Package>
</Wix>
