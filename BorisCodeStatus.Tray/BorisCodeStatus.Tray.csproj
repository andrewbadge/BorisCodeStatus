<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BorisCodeStatus.Tray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The dog, for Explorer, the Start Menu, Alt-Tab and Installed Apps. One of two places a
         committed binary is unavoidable (the waiting sounds are the other): the toolchain takes an
         .ico path, not pixel data like DogSprites. The design's 16/24/32/48/64/256 tray icons, so it stays crisp
         at every size Windows asks for. The badge-less idle face: a state badge means nothing on a
         static icon. -->
    <ApplicationIcon>fido.ico</ApplicationIcon>

    <!-- Self-contained so the MSI installs per-user with no runtime prerequisite and no elevation.
         Not single-file: the ASP.NET Core host starts faster from a normal folder layout, and the
         MSI ships a directory anyway. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required to consume the referenced ASP.NET Core project from a WinForms host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The firewall rule matching is Windows-only and so cannot live in Core, but it is exactly
         the kind of parsing that deserves tests. Exposed to the test project rather than made
         public: it is an implementation detail, not API. -->
    <InternalsVisibleTo Include="BorisCodeStatus.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The waiting sounds, embedded rather than copied: the MSI harvests the output folder, and
         a resource cannot be left behind or deleted from the install. By freesound_community on
         Pixabay, under the Pixabay Content License - see the README's Third-party components. -->
    <EmbeddedResource Include="Sounds\*.wav" LogicalName="Sounds.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BorisCodeStatus.Core\BorisCodeStatus.Core.csproj" />
    <ProjectReference Include="..\BorisCodeStatus.Api\BorisCodeStatus.Api.csproj" />
  </ItemGroup>

</Project>
