<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Single source of the version stamped onto every assembly and onto the MSI. -->
    <Version>1.1.0</Version>
    <Product>BorisCodeStatus</Product>
    <Company>Andrew Badge</Company>
    <Copyright>Copyright (C) 2026 Andrew Badge. Licensed under GPL-3.0-or-later.</Copyright>
  </PropertyGroup>

</Project>
