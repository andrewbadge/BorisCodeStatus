<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BorisClaudeNotifications.Tray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The dog, for Explorer, the Start Menu, Alt-Tab and Installed Apps. This is the one place
         a committed binary is unavoidable: the toolchain takes an .ico path, not pixel data like
         DogSprites. Built from the design's 16/20/24/32/48/64/256 tray sheets so it stays crisp
         at every size Windows asks for, and from the orange "working" variant because orange is
         the brand colour here rather than a state. -->
    <ApplicationIcon>fido.ico</ApplicationIcon>

    <!-- Self-contained so the MSI installs per-user with no runtime prerequisite and no elevation.
         Not single-file: the ASP.NET Core host starts faster from a normal folder layout, and the
         MSI ships a directory anyway. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required to consume the referenced ASP.NET Core project from a WinForms host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The firewall rule matching is Windows-only and so cannot live in Core, but it is exactly
         the kind of parsing that deserves tests. Exposed to the test project rather than made
         public: it is an implementation detail, not API. -->
    <InternalsVisibleTo Include="BorisClaudeNotifications.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BorisClaudeNotifications.Core\BorisClaudeNotifications.Core.csproj" />
    <ProjectReference Include="..\BorisClaudeNotifications.Api\BorisClaudeNotifications.Api.csproj" />
  </ItemGroup>

</Project>
