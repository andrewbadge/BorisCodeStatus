<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FidoRelay.Hooks</RootNamespace>

    <!-- Published self-contained so Claude Code can invoke it on a machine with no matching
         shared runtime installed. Single-file keeps the hook registration a single quoted path.
         Trimming is off deliberately: the saving is not worth risking a silently broken hook. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FidoRelay.Core\FidoRelay.Core.csproj" />
  </ItemGroup>

</Project>
